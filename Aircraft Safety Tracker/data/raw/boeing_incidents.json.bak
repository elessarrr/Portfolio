  {
    "model_name": "Boeing 707-100",
    "date": "16 Dec 1981",
    "type": "Boeing 707-124",
    "operator": "Hispaniola Airways",
    "location": "Miami International Airport, FL (MIA)",
    "category": "",
    "fatalities": 0,
    "narrative": "The right main gear track beam failed on landing due to fatigue. The front wheels separated. \n \nPROBABLE CAUSE: \nairframe - landing gear: main gear-shock absorbing assy,struts,attachments,etc. \nmiscellaneous acts,conditions - fatigue",
