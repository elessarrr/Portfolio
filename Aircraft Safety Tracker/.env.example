FLASK_APP=run.py
FLASK_ENV=development
# Required in production (FLASK_CONFIG=production). App refuses to boot if missing
# or set to a known placeholder. Generate e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:////absolute/path/to/data/aircraft_safety.db
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key-here
CACHE_TYPE=SimpleCache
